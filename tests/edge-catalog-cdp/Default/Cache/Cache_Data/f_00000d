/* Keep reference artwork separate from live controls and text. */
.feature-card{display:grid;grid-template-rows:minmax(0,1fr) auto 30px;align-content:stretch;gap:5px}
.feature-card>svg{margin:0;align-self:start}
.feature-card strong{align-self:end;line-height:1.15}
.feature-card small{margin:0;align-self:start;max-width:86%;line-height:1.4}
.feature-art{width:43%;height:54%;right:0;top:0;overflow:hidden;border-radius:0 14px 0 12px;opacity:1}
.feature-art .crop{width:100%;height:100%}
.feature-card[data-feature="1"] .feature-art{width:48%;height:48%;top:9px;right:7px;border-radius:10px}
.favorite{top:8px;right:8px;width:28px;height:28px;display:grid;place-items:center;background:#ffffffed;color:#b54869;box-shadow:0 2px 7px #56373d18}
.favorite[aria-pressed=true]{color:white}
.look-photo .crop{background:#f4dce2}
.map-action{right:8px;bottom:8px;background:#fff;padding:8px 12px;font-size:10px;box-shadow:0 2px 8px #56373d18}
@media(max-width:1100px){.feature-card small{max-width:100%;font-size:9px}.feature-card{grid-template-rows:minmax(0,1fr) auto 27px}}
@media(max-width:760px){.feature-card{grid-template-rows:minmax(0,1fr) auto;gap:3px}.feature-card small{display:none}.favorite{top:4px;right:4px;width:23px;height:23px}.favorite svg{width:16px;height:16px}.map-action{font-size:7px;padding:4px;right:3px;bottom:3px}}
/* Show the complete lash photo without enlarging it to fill a wide card. */
.look-photo{background:#f6e3e8;padding:4px 8px}.look-photo .crop{background:transparent}

/* Wide source crops fill the photo frame with their original proportions. */
.look-photo{padding:0;background:#f6e3e8}
.favorite{top:0;right:0;width:44px;height:43px;border-radius:0 0 0 18px;background:#fff3f6;box-shadow:none}
.favorite svg{width:20px;height:20px}
