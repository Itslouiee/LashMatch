.feature-card>svg{justify-self:start;align-self:start}
.feature-card strong,.feature-card small{justify-self:stretch;text-align:left;max-width:100%}
.feature-card small{padding-right:18px}
.feature-art,.feature-card[data-feature="1"] .feature-art{top:8px;right:8px;width:42%;height:48%;border-radius:10px;overflow:hidden;background:#fbedf0}
